# NovaFlow (Next) Configuration
# Kopiere diese Datei zu .env und fuelle die Werte aus

# ============================================
# STT PROVIDER
# ============================================
# voxtral = Voxtral Mini via OpenRouter (empfohlen, Cloud, $0.003/min)
# whisper = Lokales faster-whisper Modell (kein Internet noetig)
STT_PROVIDER=voxtral

# ============================================
# WHISPER SETTINGS (nur bei STT_PROVIDER=whisper)
# ============================================
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=auto

# ============================================
# INTERFACE SETTINGS
# ============================================
# Windows Standard: ctrl_win | Mac Standard: ctrl_cmd
# Weitere Kombinationen moeglich: ctrl, ctrl_l, alt, alt_l, shift, f8, f9, f10
HOTKEY=
SAMPLE_RATE=16000

# ============================================
# LLM PROVIDER
# ============================================
# openrouter, ollama, disabled
LLM_PROVIDER=openrouter

# LLM Modell-Name (fuer Ollama), z.B. gemma4:e4b oder gemma4:e2b
LLM_MODEL=gemma4:e4b

# ============================================
# OLLAMA SETTINGS (lokal)
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=30

# ============================================
# OPENROUTER API (empfohlen) - Gemini Flash, Claude Sonnet, Qwen 3.6
# ============================================
# Key holen: https://openrouter.ai/keys
# Modelle: google/gemini-3.1-flash-lite, anthropic/claude-3.5-sonnet, qwen/qwen3.6-plus:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# ============================================
# PERFORMANCE: LLM-Schwellenwert
# ============================================
# Texte mit weniger als LLM_WORD_THRESHOLD Woertern ueberspringen den LLM-Schritt.
LLM_WORD_THRESHOLD=10

# ============================================
# SPRACHE & LOGGING
# ============================================
LANGUAGE=de
LOG_LEVEL=INFO
